rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function admin() {
      return signedIn()
        && request.auth.token.email == "COLOQUE_AQUI_O_EMAIL_ADMINISTRATIVO"
        && request.auth.token.firebase.sign_in_provider == "password";
    }
    function validReservation(numberId) {
      return request.resource.data.keys().hasAll(
          ['number', 'name', 'phone', 'status', 'createdAt'])
        && request.resource.data.keys().hasOnly(
          ['number', 'name', 'phone', 'status', 'createdAt'])
        && request.resource.data.number == numberId
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 90
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 6
        && request.resource.data.phone.size() <= 25
        && request.resource.data.status == "Ocupado"
        && request.resource.data.createdAt is string;
    }

    match /reservas/{numberId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && numberId.matches('^(00[1-9]|0[1-9][0-9]|[1-3][0-9][0-9]|400)$')
        && validReservation(numberId);
      allow update: if admin() && validReservation(numberId);
      allow delete: if admin();
    }
  }
}